<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_widget"
    android:paddingHorizontal="12dp" android:paddingVertical="12dp" android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="10dp" android:paddingVertical="9dp" android:layout_marginHorizontal="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الدولار" android:textSize="11.5sp" android:textColor="@color/muted" android:maxLines="1"  />
            <TextView android:id="@+id/usd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="21sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/usd_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textSize="9.5sp" android:textColor="@color/faint" android:maxLines="1"  />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="10dp" android:paddingVertical="9dp" android:layout_marginHorizontal="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ذهب عيار 24" android:textSize="11.5sp" android:textColor="@color/muted" android:maxLines="1"  />
            <TextView android:id="@+id/g24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="21sp" android:textColor="@color/gold" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/g24_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textSize="9.5sp" android:textColor="@color/faint" android:maxLines="1"  />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="10dp" android:paddingVertical="9dp" android:layout_marginHorizontal="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ذهب عيار 21" android:textSize="11.5sp" android:textColor="@color/muted" android:maxLines="1"  />
            <TextView android:id="@+id/g21" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="21sp" android:textColor="@color/gold" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/g21_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textSize="9.5sp" android:textColor="@color/faint" android:maxLines="1"  />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نيويورك" android:textSize="13.5sp" android:textColor="@color/ink" android:maxLines="1" android:textStyle="bold"  />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ET" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1" android:fontFamily="@font/num_semibold" android:layout_marginStart="5dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/New_York" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15.5sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فلوريدا، جورجيا، أوهايو، ميشيغان، بنسلفانيا، نيوجيرسي، فيرجينيا، ماريلاند" android:textSize="10sp" android:textColor="@color/faint" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="1dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تكساس" android:textSize="13.5sp" android:textColor="@color/ink" android:maxLines="1" android:textStyle="bold"  />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CT" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1" android:fontFamily="@font/num_semibold" android:layout_marginStart="5dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Chicago" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15.5sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إلينوي، مينيسوتا، ويسكونسن، ميزوري، لويزيانا، ألاباما، أوكلاهوما" android:textSize="10sp" android:textColor="@color/faint" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="كاليفورنيا" android:textSize="13.5sp" android:textColor="@color/ink" android:maxLines="1" android:textStyle="bold"  />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PT" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1" android:fontFamily="@font/num_semibold" android:layout_marginStart="5dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Los_Angeles" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15.5sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="واشنطن، أوريجون، نيفادا" android:textSize="10sp" android:textColor="@color/faint" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="1dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="كولورادو" android:textSize="13.5sp" android:textColor="@color/ink" android:maxLines="1" android:textStyle="bold"  />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MT" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1" android:fontFamily="@font/num_semibold" android:layout_marginStart="5dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Denver" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15.5sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="يوتا، نيو مكسيكو، مونتانا، وايومنغ، أيداهو" android:textSize="10sp" android:textColor="@color/faint" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="10dp" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="محوّل المواعيد" android:textSize="13.5sp" android:textColor="@color/ink" android:maxLines="1" android:textStyle="bold"  />
            <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/conv_now" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:background="@drawable/chip" android:paddingHorizontal="12dp" android:text="الآن" android:textSize="11sp" android:textColor="@color/accent_soft" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/conv_mode" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:background="@drawable/btn_accent" android:paddingHorizontal="12dp" android:text="مصر ← أمريكا  ⇄" android:textSize="11sp" android:textColor="@color/ink" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <TextView android:id="@+id/m60" android:layout_width="44dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/btn" android:text="−1س" android:textSize="12sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:layout_marginHorizontal="2dp" /><TextView android:id="@+id/m30" android:layout_width="44dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/btn" android:text="−30د" android:textSize="12sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:layout_marginHorizontal="2dp" />
            <LinearLayout android:id="@+id/conv_src_box" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/conv_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
                <TextView android:id="@+id/conv_src" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="توقيت مصر" android:textSize="10.5sp" android:textColor="@color/accent_soft" android:maxLines="1"  />
            </LinearLayout>
            <TextView android:id="@+id/p30" android:layout_width="44dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/btn" android:text="+30د" android:textSize="12sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:layout_marginHorizontal="2dp" /><TextView android:id="@+id/p60" android:layout_width="44dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/btn" android:text="+1س" android:textSize="12sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:layout_marginHorizontal="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:id="@+id/r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="6dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10.5sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="1dp" />
                <TextView android:id="@+id/r1_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
            <LinearLayout android:id="@+id/r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="6dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10.5sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="1dp" />
                <TextView android:id="@+id/r2_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
            <LinearLayout android:id="@+id/r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="6dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10.5sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="1dp" />
                <TextView android:id="@+id/r3_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
            <LinearLayout android:id="@+id/r4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="6dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r4_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10.5sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold" android:layout_marginTop="1dp" />
                <TextView android:id="@+id/r4_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="اضغط تحديث" android:textSize="10.5sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:background="@drawable/btn_accent" android:paddingHorizontal="16dp" android:text="↻  تحديث الأسعار" android:textSize="12sp" android:textColor="@color/ink" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
