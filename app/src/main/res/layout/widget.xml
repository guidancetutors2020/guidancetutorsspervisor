<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_widget"
    android:paddingHorizontal="10dp" android:paddingVertical="10dp" android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="10dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الدولار" android:textSize="11sp" android:textColor="@color/muted" android:maxLines="1"  />
            <TextView android:id="@+id/usd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="19sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
            <TextView android:id="@+id/usd_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1"  />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="10dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ذهب عيار 24" android:textSize="11sp" android:textColor="@color/muted" android:maxLines="1"  />
            <TextView android:id="@+id/g24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="19sp" android:textColor="@color/gold" android:maxLines="1" android:fontFamily="@font/num_bold"  />
            <TextView android:id="@+id/g24_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1"  />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="10dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ذهب عيار 21" android:textSize="11sp" android:textColor="@color/muted" android:maxLines="1"  />
            <TextView android:id="@+id/g21" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="19sp" android:textColor="@color/gold" android:maxLines="1" android:fontFamily="@font/num_bold"  />
            <TextView android:id="@+id/g21_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textSize="9sp" android:textColor="@color/faint" android:maxLines="1"  />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="9dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الشرقي" android:textSize="12sp" android:textColor="@color/ink" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ET" android:textSize="9sp" android:textColor="@color/faint" android:fontFamily="@font/num_semibold" android:layout_marginStart="4dp" android:maxLines="1" />
                <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/New_York" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/st_e" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="4" android:lineSpacingExtra="1.5dp" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="9dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المركزي" android:textSize="12sp" android:textColor="@color/ink" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CT" android:textSize="9sp" android:textColor="@color/faint" android:fontFamily="@font/num_semibold" android:layout_marginStart="4dp" android:maxLines="1" />
                <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Chicago" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/st_c" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="4" android:lineSpacingExtra="1.5dp" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="9dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الجبلي" android:textSize="12sp" android:textColor="@color/ink" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MT" android:textSize="9sp" android:textColor="@color/faint" android:fontFamily="@font/num_semibold" android:layout_marginStart="4dp" android:maxLines="1" />
                <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Denver" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/st_m" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="4" android:lineSpacingExtra="1.5dp" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/tile" android:paddingHorizontal="9dp" android:paddingVertical="7dp" android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الغربي" android:textSize="12sp" android:textColor="@color/ink" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PT" android:textSize="9sp" android:textColor="@color/faint" android:fontFamily="@font/num_semibold" android:layout_marginStart="4dp" android:maxLines="1" />
                <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Los_Angeles" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textSize="15sp" android:textColor="@color/accent_soft" android:fontFamily="@font/num_bold" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/st_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="4" android:lineSpacingExtra="1.5dp" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:paddingHorizontal="8dp" android:paddingVertical="8dp" android:layout_marginTop="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حوّل ميعاد" android:textSize="13sp" android:textColor="@color/ink" android:maxLines="1" android:textStyle="bold" android:layout_marginStart="4dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/conv_mode" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:background="@drawable/btn_accent" android:paddingHorizontal="12dp" android:text="مصر ← أمريكا  ⇄" android:textSize="11.5sp" android:textColor="@color/ink" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/input" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:layout_marginTop="7dp" android:layout_marginHorizontal="2dp">
            <TextView android:id="@+id/conv_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اكتب الوقت بتوقيت مصر" android:textSize="11sp" android:textColor="@color/accent_soft" android:maxLines="1"  />
            <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/conv_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="21sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:layoutDirection="ltr"><TextView android:id="@+id/k1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="1" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="2" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="3" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k4" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="4" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k5" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="5" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:layoutDirection="ltr"><TextView android:id="@+id/k6" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="6" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k7" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="7" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k8" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="8" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k9" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="9" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/k0" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key" android:text="0" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:layoutDirection="ltr"><TextView android:id="@+id/kam" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key_soft" android:text="AM" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/kpm" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key_soft" android:text="PM" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="@font/num_semibold" android:maxLines="1" /><TextView android:id="@+id/know" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key_soft" android:text="الآن" android:textSize="12sp" android:textColor="@color/accent_soft" android:maxLines="1" /><TextView android:id="@+id/kclr" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key_soft" android:text="مسح" android:textSize="12sp" android:textColor="@color/accent_soft" android:maxLines="1" /><TextView android:id="@+id/kdel" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:background="@drawable/key_soft" android:text="⌫" android:textSize="15sp" android:textColor="@color/ink" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/res_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الوقت ده في أمريكا" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="1" android:layout_marginTop="7dp" android:layout_marginStart="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <LinearLayout android:id="@+id/r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="5dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="14sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
                <TextView android:id="@+id/r1_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" " android:textSize="8.5sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
            <LinearLayout android:id="@+id/r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="5dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="14sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
                <TextView android:id="@+id/r2_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" " android:textSize="8.5sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
            <LinearLayout android:id="@+id/r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="5dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="14sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
                <TextView android:id="@+id/r3_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" " android:textSize="8.5sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
            <LinearLayout android:id="@+id/r4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/chip" android:paddingVertical="5dp" android:layout_marginHorizontal="2dp">
                <TextView android:id="@+id/r4_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="1"  />
                <TextView android:id="@+id/r4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="14sp" android:textColor="@color/ink" android:maxLines="1" android:fontFamily="@font/num_bold"  />
                <TextView android:id="@+id/r4_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" " android:textSize="8.5sp" android:textColor="@color/gold" android:maxLines="1"  />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="اضغط تحديث" android:textSize="10.5sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" />
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:background="@drawable/btn_accent" android:paddingHorizontal="14dp" android:text="↻  تحديث الأسعار" android:textSize="11.5sp" android:textColor="@color/ink" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
