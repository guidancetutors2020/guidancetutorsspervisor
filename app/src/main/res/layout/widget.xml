<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg" android:padding="12dp" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الدولار · سعر البنك" android:textColor="@color/muted" android:textSize="11sp" />
            <TextView android:id="@+id/usd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/usd" android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
            <TextView android:id="@+id/usd_src" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textColor="@color/muted" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جرام دهب عيار 24 · الصاغة" android:textColor="@color/muted" android:textSize="11sp" />
            <TextView android:id="@+id/gold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/gold" android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
            <TextView android:id="@+id/gold_src" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جنيه" android:textColor="@color/muted" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginVertical="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="نيويورك" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/New_York" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فلوريدا، جورجيا، أوهايو، ميشيغان، بنسلفانيا، نيوجيرسي، فيرجينيا، الكارولينتين، ماريلاند، ماساتشوستس" android:textColor="@color/muted" android:textSize="9.5sp" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="تكساس" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Chicago" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إلينوي، مينيسوتا، ويسكونسن، ميزوري، أيوا، لويزيانا، ألاباما، ميسيسيبي، أوكلاهوما، كانساس" android:textColor="@color/muted" android:textSize="9.5sp" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="كاليفورنيا" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Los_Angeles" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="واشنطن، أوريجون، نيفادا" android:textColor="@color/muted" android:textSize="9.5sp" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="كولورادو" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
                    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:timeZone="America/Denver" android:format12Hour="h:mm a" android:format24Hour="h:mm a" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="يوتا، نيو مكسيكو، مونتانا، وايومنغ، أيداهو" android:textColor="@color/muted" android:textSize="9.5sp" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="اضغط تحديث" android:textColor="@color/muted" android:textSize="10sp" />
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻  تحديث" android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/pill" android:paddingHorizontal="14dp" android:paddingVertical="6dp" />
    </LinearLayout>
</LinearLayout>
